[program:laravel-crm-sms-worker]
command=/usr/bin/php /var/www/laravel-crm/artisan queue:work database --queue=sms --sleep=1 --tries=1 --timeout=20 --max-time=3600
directory=/var/www/laravel-crm
user=www-data
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=30
redirect_stderr=true
stdout_logfile=/var/www/laravel-crm/storage/logs/sms-worker.log

[program:laravel-crm-sms-receiver]
command=/usr/bin/php /var/www/laravel-crm/artisan sms:receive
directory=/var/www/laravel-crm
user=www-data
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=10
redirect_stderr=true
stdout_logfile=/var/www/laravel-crm/storage/logs/sms-receiver.log
