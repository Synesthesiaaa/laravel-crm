; Example for Linux servers using Supervisor.
; Update paths, PHP version, user and queue connection for your deployment.
; The queue connection MUST match EMAIL_CAMPAIGN_CONNECTION in Laravel's .env.
; email-database/email-redis are separate connections from the default queue.
; Web and worker must share the same cache store, prefix and cached configuration.
; Use only one worker to preserve email batch pacing.
[program:laravel-crm-email]
directory=/var/www/laravel-crm
command=/usr/bin/php /var/www/laravel-crm/artisan queue:work email-database --queue=email-campaigns --sleep=1 --tries=1 --timeout=60 --max-time=3600
; Set this to the application's PHP-FPM/service account after verifying access.
user=www-data
numprocs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=90
redirect_stderr=true
stdout_logfile=/var/log/supervisor/laravel-crm-email.log
